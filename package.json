{
  "name": "tidewave",
  "version": "0.8.2",
  "description": "Tidewave for JavaScript (TanStack, Vite)",
  "keywords": [
    "typescript",
    "documentation",
    "mcp",
    "cli",
    "tidewave",
    "vite",
    "tanstack"
  ],
  "homepage": "https://tidewave.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tidewave-ai/tidewave_js.git"
  },
  "license": "Apache-2.0",
  "author": "Dashbit",
  "type": "module",
  "bin": {
    "tidewave": "dist/cli/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.mts",
      "default": "./dist/vite-plugin.mjs"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.mts",
      "default": "./dist/tanstack.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type:check": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.32.1",
    "body-parser": "^2.2.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "typescript": "^5",
    "ws": "^8.21.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/body-parser": "^1.19.6",
    "@types/node": "^22.10.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsdown": "^0.23.1",
    "vite": "^7.1.5",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "typescript": "^5",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

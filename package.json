{
  "name": "tidewave",
  "version": "0.9.0",
  "description": "Tidewave for JavaScript (TanStack, Vite)",
  "keywords": [
    "cli",
    "documentation",
    "mcp",
    "tanstack",
    "tidewave",
    "typescript",
    "vite"
  ],
  "homepage": "https://tidewave.ai",
  "license": "Apache-2.0",
  "author": "Dashbit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tidewave-ai/tidewave_js.git"
  },
  "bin": {
    "tidewave": "dist/cli/index.mjs"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite-plugin": {
      "types": "./dist/vite-plugin.d.mts",
      "default": "./dist/vite-plugin.mjs"
    },
    "./tanstack": {
      "types": "./dist/tanstack.d.mts",
      "default": "./dist/tanstack.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type:check": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "body-parser": "^2.3.0",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "typescript": "^6.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/node": "^22.19.0",
    "@types/ws": "^8.18.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pkg-pr-new": "^0.0.91",
    "tsdown": "^0.23.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.13.0"
}
